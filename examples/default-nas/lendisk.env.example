# Copy to lendisk.env, fill in, then: chown root:root lendisk.env && chmod 0600 lendisk.env
# Compose passes these as environment variables; the daemon never writes them anywhere (SEC-3).

# Backblaze B2 application key for the overflow target named "b2" in lendisk.toml.
# Capabilities: listBuckets, listFiles, readFiles, writeFiles. No deleteFiles (S3-5):
# hiding a file (a delete marker) is expected to need only writeFiles; DESIGN Q-AC checks it.
LENDISK_OVERFLOW_B2_ACCESS_KEY=003xxxxxxxxxxxx0000000001
LENDISK_OVERFLOW_B2_SECRET_KEY=K003xxxxxxxxxxxxxxxxxxxxxxxxxxx
