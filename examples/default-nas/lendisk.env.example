# Copy to lendisk.env, fill in, then: chown root:root lendisk.env && chmod 0600 lendisk.env
# Compose passes these as environment variables; the daemon never writes them anywhere (SEC-3).

# Backblaze B2 application key for the external replica named "b2" in lendisk.toml.
# Capabilities: listBuckets, listFiles, readFiles, writeFiles. No deleteFiles (S3-5).
LENDISK_REPLICA_B2_ACCESS_KEY=003xxxxxxxxxxxx0000000001
LENDISK_REPLICA_B2_SECRET_KEY=K003xxxxxxxxxxxxxxxxxxxxxxxxxxx
