# Copy to lendisk.env, then: chown root:root lendisk.env && chmod 0600 lendisk.env
# The Garage key `lendisk` (garage key create / garage key allow --create-bucket).
LENDISK_STORE_ACCESS_KEY=GKxxxxxxxxxxxxxxxxxxxxxxxx
LENDISK_STORE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
