# Copy to lendisk.env, then: chown root:root lendisk.env && chmod 0600 lendisk.env
# Hetzner Object Storage credential for the store (EP-16). It must be able to
# create buckets: lendisk makes kopia-dag, a lent-<id>-<sealed> bucket for each
# friend's bucket it holds (Anna's laptop, Björn's photos), and lendisk-manifests.
LENDISK_STORE_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
LENDISK_STORE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
