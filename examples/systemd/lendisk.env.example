# /etc/lendisk.env  — root:root, mode 0600. Read by systemd, not by the daemon's user.
# Set only the variables your node needs.

# One pair per overflow target created with `lendisk overflow add <name>`,
# <NAME> upper-cased, or the prefix given with --env-prefix (S3-1).
#LENDISK_OVERFLOW_B2_ACCESS_KEY=
#LENDISK_OVERFLOW_B2_SECRET_KEY=

# Store credential, only for the post-v1 `s3` store backend (EP-16).
#LENDISK_STORE_ACCESS_KEY=
#LENDISK_STORE_SECRET_KEY=

