# /etc/lendisk.env  — root:root, mode 0600. Read by systemd, not by the daemon's user.
# Set only the variables your lendisk.toml needs.

# Store credential, only when [store] backend = "s3" (EP-16).
#LENDISK_STORE_ACCESS_KEY=
#LENDISK_STORE_SECRET_KEY=

# One pair per [[replica]] entry, <NAME> upper-cased (S3-1).
#LENDISK_REPLICA_B2_ACCESS_KEY=
#LENDISK_REPLICA_B2_SECRET_KEY=
