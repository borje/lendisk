# /etc/systemd/system/lendisk.service
# The same daemon without Docker: one static binary, one unit (D2, COMPAT-2).
#
#   useradd --system --home /var/lib/lendisk --shell /usr/sbin/nologin lendisk
#   install -d -m 0700 -o lendisk -g lendisk /etc/lendisk /var/lib/lendisk
#   install -m 0600 -o root -g root lendisk.env /etc/lendisk.env
#   sudo -u lendisk lendisk init --config /etc/lendisk/lendisk.toml
#   systemctl enable --now lendisk

[Unit]
Description=lendisk: lend and borrow disk space for offsite backups
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lendisk
Group=lendisk
ExecStart=/usr/local/bin/lendisk serve --config /etc/lendisk/lendisk.toml
Restart=on-failure
RestartSec=5s

# SEC-3: third-party credentials (overflow targets) come from a root-owned file the service
# user cannot read; systemd injects them as environment variables.
EnvironmentFile=-/etc/lendisk.env

# Hardening in the spirit of OPS-7 and SEC-8.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/lendisk /var/lib/lendisk
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# v1 does not use UPnP/NAT-PMP/PCP port mapping (DESIGN Q-R); if a later
# release adds it (#46), AF_NETLINK may be needed here.

[Install]
WantedBy=multi-user.target
